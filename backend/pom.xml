<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sshomcat</groupId>
    <artifactId>sshomcat-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>sshomcat-backend</artifactId>
  <packaging>war</packaging>

  <name>sshomcat-backend</name>
  <description>SSHomcat SSH-to-WebSocket bridge (Jakarta EE 10 / Tomcat 10.1)</description>

  <properties>
    <sshd.version>2.14.0</sshd.version>
    <servlet.version>6.0.0</servlet.version>
    <websocket.version>2.1.1</websocket.version>
    <jsonp.version>2.0.1</jsonp.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>

  <dependencies>
    <!--
      The module contract. Bundled into WEB-INF/lib so ModuleLoader's classloader (parented to
      the webapp's) resolves every module against this one copy.
    -->
    <dependency>
      <groupId>com.sshomcat</groupId>
      <artifactId>module-api</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      Tomcat 10.1 only implements Servlet/JSP/EL/WebSocket: it is NOT a full Jakarta EE
      app server (no CDI, no JAX-RS, no JSON-B). Depend on the individual specs it actually
      provides at runtime, not the umbrella jakartaee-web-api, so `provided` scope is accurate.
    -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>${servlet.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.websocket</groupId>
      <artifactId>jakarta.websocket-api</artifactId>
      <version>${websocket.version}</version>
      <scope>provided</scope>
    </dependency>
    <!--
      jakarta.websocket-api only carries the `jakarta.websocket.server` package; the base
      package (Session, Endpoint, OnOpen/OnMessage/OnClose/OnError, CloseReason...) lives in
      this client-api artifact. Its own dependency on it is `provided` (non-transitive), so it
      must be declared explicitly here too.
    -->
    <dependency>
      <groupId>jakarta.websocket</groupId>
      <artifactId>jakarta.websocket-client-api</artifactId>
      <version>${websocket.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      JSON-P (reference implementation). Tomcat does not ship this, so it's compile-scope and
      bundled into WEB-INF/lib. Chosen over hand-rolled JSON parsing so escaping/unicode in the
      protocol (docs/api.md) is handled correctly, and over Jackson/Gson for footprint:
      zero transitive dependencies.
    -->
    <dependency>
      <groupId>org.glassfish</groupId>
      <artifactId>jakarta.json</artifactId>
      <version>${jsonp.version}</version>
    </dependency>

    <!-- SSH client: pure Java, actively maintained (see docs/architecture.md). -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <version>${sshd.version}</version>
    </dependency>

    <!--
      sshd-core logs via slf4j; ship a binding so it doesn't fall back to a no-op logger (every
      SSH-leg diagnostic: kex failure, host-key rejection, auth detail: would otherwise be
      invisible). sshd-core transitively pulls slf4j-api 1.7.x, which looks for the old
      StaticLoggerBinder and silently no-ops against a 2.x binding. Declaring slf4j-api directly
      here wins dependency mediation (nearest declaration) and forces the whole WAR onto 2.x.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>sshomcat</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
        <configuration>
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
